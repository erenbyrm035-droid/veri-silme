# ==========================================
# AI Fitness Coach - Ortam Değişkenleri
# Bu dosyayı .env.local olarak kopyalayın ve değerleri doldurun.
# ==========================================

# --- Supabase ---
# Supabase Dashboard > Project Settings > API bölümünden alınır.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Sadece sunucu tarafında kullanılır (admin işlemleri). ASLA client'a sızdırmayın.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- AI Coach ---
# Sağlayıcı seçimi: "openai" (varsayılan) veya "anthropic"
AI_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o-mini

# Anthropic (Claude) — AI_PROVIDER=anthropic ise kullanılır
ANTHROPIC_API_KEY=sk-ant-your-key
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# --- Uygulama ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
